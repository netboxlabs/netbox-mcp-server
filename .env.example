# NetBox MCP Server Configuration
# Copy this file to .env and customize for your environment

# ===== Core NetBox Configuration (REQUIRED) =====
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=your_api_token_here

# ===== Transport Configuration =====
# Options: stdio (default, for Claude Desktop/Code) or http (for web clients)
TRANSPORT=stdio

# ===== HTTP Transport Settings =====
# Only used when TRANSPORT=http
HOST=127.0.0.1
PORT=8000

# Use each client's own NetBox token instead of NETBOX_TOKEN (HTTP only).
# Clients send 'Authorization: Bearer <their netbox token>'. Leave NETBOX_TOKEN unset.
# TOKEN_PASSTHROUGH=true
# Seconds to remember an accepted token (0 = check NetBox on every request)
# TOKEN_CACHE_TTL=60
# Send each client's IP to NetBox so token "Allowed IPs" apply to the real user
# FORWARD_CLIENT_IP=true

# ===== Security Settings =====
# Set to false only for testing with self-signed certificates
VERIFY_SSL=true
CORS_ORIGINS='["http://localhost:6274"]'

# ===== Logging Configuration =====
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
